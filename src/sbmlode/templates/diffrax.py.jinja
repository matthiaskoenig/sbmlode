def trigger_change(
    t: jax.Array, y: jax.Array, args: tuple[jax.Array, jax.Array], **kwargs: object
) -> jax.Array:
    """The root function of a change of the triggers, positive where one changed.

    The function of each trigger, negated where the trigger holds, is negative until
    the trigger changes; their maximum turns positive at the first change, which
    diffrax locates as its root.
    """
    p, holds = args
    roots = event_triggers(t, y{{ "[:0]" if not states }}, p)
    return jnp.max(jnp.where(holds, -roots, roots))


def first_change(
    t: jax.Array, x: jax.Array, p: jax.Array, holds: jax.Array, t_start: jax.Array
) -> tuple[jax.Array, jax.Array]:
    """The time at which a trigger changes, near the root of its function at t.

    The root of the function of a trigger is located to `ROOT_TOLERANCE`, the trigger
    changes at its root or right after it: bisection on the linear extrapolation of
    the states x at t finds the first time with a change within `ROOT_WINDOW` of t,
    from the start of the segment on, where the triggers are `holds`, to the rounding
    error. `time >= 1` changes at t = 1. A trigger which keeps its value at its root
    and changes right after it, `time > 1` at t = 1, changes at a time clearly after
    the root, as an integrator locates it, so that the time stays after the root when
    a delay is added to it.

    Args:
        t: the root
        x: the states at t
        p: the constants
        holds: whether each trigger held before t
        t_start: the start of the segment of the integration

    Returns:
        the time of the change, and whether a trigger changes near t at all
    """
    dx = f_dxdt(t, x, p)

    def changed(t_point: jax.Array) -> jax.Array:
        return jnp.any(event_conditions(t_point, x + (t_point - t) * dx, p) != holds)

    def bisect(
        _: int, bounds: tuple[jax.Array, jax.Array]
    ) -> tuple[jax.Array, jax.Array]:
        t_low, t_high = bounds
        t_middle = t_low + (t_high - t_low) / 2
        change = changed(t_middle)
        return jnp.where(change, t_low, t_middle), jnp.where(change, t_middle, t_high)

    window = ROOT_WINDOW * jnp.maximum(1.0, jnp.abs(t))
    t_first = jnp.maximum(t - window, t_start)
    early = changed(t_first)
    late = changed(t + window)
    t_low, t_high = jax.lax.fori_loop(0, 64, bisect, (t_first, t + window))
    turned = event_conditions(t_high, x + (t_high - t) * dx, p) != holds
    roots = event_triggers(t_low, x + (t_low - t) * dx, p)
    at_root = jnp.any(turned & (roots == 0.0))
    t_after = t_low + 1e-13 * jnp.maximum(1.0, jnp.abs(t_low))
    t_high = jnp.where(at_root, t_after, t_high)
    t_change = jnp.where(early, t_first, jnp.where(late, t_high, t))
    return t_change, early | late


def execute_events(
    t: jax.Array,
    x: jax.Array,
    p: jax.Array,
    holds: jax.Array,
    queue: Queue,
    kind: str,
) -> tuple[jax.Array, jax.Array, jax.Array, Queue]:
    """Execute the events due at the time t.

    1. A trigger which turned true schedules an execution of its event at t plus
       its delay, with the values of its assignments if it uses the values from
       the trigger time; a trigger which turned false drops the executions of its
       event unless it is persistent.
    2. Of the executions due, the one of the highest priority is executed (an
       event without a priority has the priority 0), ties in the order of
       `EVENT_IDS`, then of their scheduling, which SBML leaves to chance.
    3. The triggers are evaluated with the new states and constants, repeating
       from step 1 until no execution is due: an event can trigger another one or
       drop it. More than `MAX_CASCADE` executions at one time raise.

    Args:
        t: the time
        x: the states
        p: the constants
        holds: whether each trigger held before t
        queue: the scheduled executions
        kind: the kind of the loop of the cascade, see `loop_kind`

    Returns:
        the states, the constants, whether each trigger holds and the scheduled
        executions, after the events

    Raises:
        RuntimeError: for more than `MAX_CASCADE` executions, an infinite cascade,
            and for more scheduled executions than the queue has slots
    """
    slots = jnp.arange(queue.event.shape[0])

    def put(
        event_index: jax.Array, x: jax.Array, p: jax.Array, queue: Queue
    ) -> tuple[jax.Array, Queue]:
        # the execution of the event in the first free slot; the errors are raised
        # by arrays which are never empty and which the simulation uses
        free = eqx.error_if(
            queue.event < 0,
            ~jnp.any(queue.event < 0),
            "More executions of events are scheduled than `max_pending`.",
        )
        here = slots == jnp.argmax(free)
        values = event_values(event_index, t, x, p)
        queue = Queue(
            event=jnp.where(here, event_index, queue.event),
            time=jnp.where(here, t + event_delay(event_index, t, x, p), queue.time),
            values=jnp.where(here[:, None], values[None, :], queue.values),
            use_values=jnp.where(
                here, USE_TRIGGER_VALUES[event_index], queue.use_values
            ),
            order=jnp.where(here, queue.scheduled, queue.order),
            scheduled=queue.scheduled + 1,
        )
        return x, queue

    def schedule(event_index: jax.Array, state: tuple) -> tuple:
        # an execution of the event if its trigger turned true; the delay and the
        # values of an event whose trigger did not turn are not evaluated
        x, p, queue, turned = state
        x, queue = jax.lax.cond(
            turned[event_index],
            put,
            lambda event_index, x, p, queue: (x, queue),
            event_index,
            x,
            p,
            queue,
        )
        return x, p, queue, turned

    def cascade(state: tuple) -> tuple:
        x, p, holds, queue, executions, _ = state
        holds_now = event_conditions(t, x, p)
        # a trigger which turned false drops the executions of its event, unless the
        # event is persistent
        dropped = holds & ~holds_now & ~PERSISTENT
        drop = (queue.event >= 0) & dropped[jnp.maximum(queue.event, 0)]
        queue = queue._replace(
            event=jnp.where(drop, -1, queue.event),
            time=jnp.where(drop, jnp.inf, queue.time),
        )
        # a trigger which turned true schedules an execution of its event
        turned = holds_now & ~holds
        x, p, queue, _ = jax.lax.fori_loop(
            0, len(EVENT_IDS), schedule, (x, p, queue, turned)
        )
        holds = holds_now

        # the execution due of the highest priority, ties in the order of the events,
        # then of their scheduling
        due = (queue.event >= 0) & (queue.time <= t)
        event = jnp.maximum(queue.event, 0)
        priority = jnp.where(due, event_priorities(t, x, p)[event], -jnp.inf)
        first = due & (priority == jnp.max(priority))
        first &= queue.event == jnp.min(jnp.where(first, queue.event, len(EVENT_IDS)))
        first &= queue.order == jnp.min(jnp.where(first, queue.order, queue.scheduled))
        slot = jnp.argmax(first)
        executed = jnp.any(due)
        event_index = event[slot]
        values = jnp.where(
            queue.use_values[slot],
            queue.values[slot],
            event_values(event_index, t, x, p),
        )
        x_new, p_new = event_assign(event_index, t, x, p, values)
        x = jnp.where(executed, x_new, x)
        p = jnp.where(executed, p_new, p)
        done = executed & (slots == slot)
        queue = queue._replace(
            event=jnp.where(done, -1, queue.event),
            time=jnp.where(done, jnp.inf, queue.time),
        )
        executions = executions + executed
        holds = eqx.error_if(
            holds,
            executions > MAX_CASCADE,
            f"More than {MAX_CASCADE} events were executed at one time, the events "
            "trigger each other in an infinite cascade.",
        )
        return x, p, holds, queue, executions, executed

    x, p, holds, queue, _, _ = eqxi.while_loop(
        lambda state: state[-1],
        cascade,
        (x, p, holds, queue, jnp.array(0), jnp.array(True)),
        max_steps=MAX_CASCADE + 1,
        kind=kind,
    )
    return x, p, holds, queue
{% endif %}


@eqx.filter_jit
def simulate(
    ts: jax.Array,
    p: jax.Array | None = None,
    x0: jax.Array | None = None,
    *,
    rtol: float = 1e-8,
    atol: float = 1e-10,
    solver: diffrax.AbstractSolver | None = None,
    adjoint: diffrax.AbstractAdjoint | None = None,
    max_step: float | None = None,
    max_steps: int | None = None,
{% if events %}
    max_segments: int = 100000,
    max_pending: int = 100,
{% endif %}
) -> Simulation:
{% if events %}
    """Simulate the model from t = 0 to the last output time, with its events.

    The triggers before t = 0 have their initial values, a trigger which holds at
    t = 0 and has the initial value false fires at t = 0. The integration stops
    where a trigger changes, at the execution of a delayed event and at the last
    output time; there the events are executed, see `execute_events`, and the
    integration restarts with the states and constants after them.

    The integration finds a change of a trigger as a root of its function at the end
    of a step, which is at most `max_step`: a trigger which holds for a shorter time
    than a step can be stepped over. An output time at a delayed execution, to the
    rounding of the time (1e-14 relative), has the values after it: the rounding
    errors of the integration shift the time of the trigger, not its integration
    error.
{% else %}
    """Simulate the model from t = 0 to the last output time.
{% endif %}

    `eqx.filter_jit` compiles the simulation for the number of output times and the
    options, the output times, the constants and the initial states are traced: a
    simulation with other values runs without a compilation.

    Args:
        ts: the output times, from 0 on and not decreasing
        p: the constants, `P0` if not given
        x0: the initial states, those of `initial_values` if not given
        rtol: the relative tolerance of the integration
        atol: the absolute tolerance of the integration
        solver: the solver of diffrax, `diffrax.Kvaerno5()` if not given, an implicit
            solver for stiff models; `diffrax.Tsit5()` for a model which is not stiff
        adjoint: the adjoint of diffrax, which decides how the simulation is
            differentiated: `diffrax.RecursiveCheckpointAdjoint()` if not given, for
            reverse mode (`jax.grad`), `diffrax.ForwardMode()` for forward mode
            (`jax.jacfwd`), `diffrax.DirectAdjoint()` for both
        max_step: the largest step of the integration, by default the distance of
            the output times, `ts[-1] / (len(ts) - 1)`
        max_steps: the largest number of steps of the integration{{ " of a segment" if events }}, by
            default `MAX_STEPS` plus twice the number of output times
{% if events %}
        max_segments: the largest number of segments of the integration, between
            the changes of the triggers and the executions of delayed events
        max_pending: the largest number of executions of events which are
            scheduled at a time
{% endif %}

    Returns:
{% if events %}
        the time, the states, the assigned values and the constants at the output
        times, at the time of an event the values after it
{% else %}
        the time, the states, the assigned values and the constants at the output
        times
{% endif %}

    Raises:
        RuntimeError: for output times which are negative or decrease, if the
            integration fails or takes more than `max_steps` steps, e.g. when a
            state grows without bound{% if events %}, for an infinite cascade of events and
            beyond `max_segments` and `max_pending`
        ValueError: for `max_pending` below 1{% endif %}

    """
    ts = jnp.asarray(ts, dtype=float)
    ts = eqx.error_if(
        ts,
        (ts[0] < 0.0) | jnp.any(ts[1:] < ts[:-1]),
        "The output times ts must not be negative and must not decrease.",
    )
    x_initial, p = initial_values(p)
    x = x_initial if x0 is None else jnp.asarray(x0, dtype=float)
    points = ts.shape[0]
    t_end = ts[-1]
    if max_step is None:
        max_step = t_end / (points - 1) if points > 1 else jnp.inf
        max_step = jnp.where(max_step > 0.0, max_step, jnp.inf)
    if max_steps is None:
        max_steps = MAX_STEPS + 2 * points
{% if events %}
    if max_pending < 1:
        raise ValueError(f"max_pending must be at least 1, not {max_pending}.")
    solver = diffrax.Kvaerno5() if solver is None else solver
    adjoint = diffrax.RecursiveCheckpointAdjoint() if adjoint is None else adjoint
    controller = diffrax.PIDController(rtol=rtol, atol=atol, dtmax=max_step)
    event = diffrax.Event(
        trigger_change,
        ChangeBisection(rtol=ROOT_TOLERANCE, atol=ROOT_TOLERANCE),
        direction=True,
    )
    kind = loop_kind(adjoint)

    # the triggers before t = 0 have their initial values
    t = jnp.asarray(0.0)
    queue = Queue(
        event=jnp.full(max_pending, -1),
        time=jnp.full(max_pending, jnp.inf),
        values=jnp.zeros((max_pending, {{ width }})),
        use_values=jnp.zeros(max_pending, dtype=bool),
        order=jnp.zeros(max_pending, dtype=int),
        scheduled=jnp.asarray(0),
    )
    x, p, holds, queue = execute_events(t, x, p, INITIAL_VALUE, queue, kind)
    xs = jnp.zeros((points, len(XIDS)))
    ps = jnp.zeros((points, len(PIDS)))

    def integrate(state: State) -> State:
        # a segment of the integration: to the change of a trigger, to the next
        # execution of a delayed event or to the last output time, and the events then
        t_stop = jnp.minimum(t_end, jnp.min(state.queue.time))
        solution = diffrax.diffeqsolve(
            diffrax.ODETerm(vector_field),
            solver,
            t0=state.t,
            t1=t_stop,
            dt0=None,
            y0={{ "state.x" if states else "jnp.zeros(1)" }},
            args=(state.p, state.holds),
            saveat=diffrax.SaveAt(
                subs=[
                    diffrax.SubSaveAt(ts=jnp.clip(ts, state.t, t_stop)),
                    diffrax.SubSaveAt(t1=True),
                ]
            ),
            stepsize_controller=controller,
            adjoint=adjoint,
            event=event,
            max_steps=max_steps,
        )
        t_root = solution.ts[1][0]
        x_root = solution.ys[1][0]{{ "[:0]" if not states }}
        at_root = solution.event_mask
        t_change, changed = first_change(
            t_root, x_root, state.p, state.holds, state.t
        )
        # the time of the change differs from the root by the rounding, which carries
        # no derivative; the derivative of the root comes from the root finder
        t_change = jnp.where(at_root & changed, t_change, t_root)
        t_next = jax.lax.stop_gradient(t_change) + (
            t_root - jax.lax.stop_gradient(t_root)
        )
        offset = jax.lax.stop_gradient(t_change - t_root)
        x_next = x_root + offset * f_dxdt(t_root, x_root, state.p)
        # the output times before the end of the segment, which a delayed execution
        # and the last output time end to the rounding of the time
        t_points = jnp.where(
            at_root, t_next, t_next - 1e-14 * jnp.maximum(1.0, jnp.abs(t_next))
        )
        inside = (ts >= state.filled) & (ts < t_points)
{% if states %}
        x_points = jnp.where((ts <= t_root)[:, None], solution.ys[0], x_next)
{% else %}
        x_points = jnp.zeros((points, 0))
{% endif %}
        xs = jnp.where(inside[:, None], x_points, state.xs)
        ps = jnp.where(inside[:, None], state.p, state.ps)
        x, p, holds, queue = execute_events(
            t_next, x_next, state.p, state.holds, state.queue, kind
        )
        filled = jnp.maximum(state.filled, t_points)
        return State(t_next, x, p, holds, queue, xs, ps, filled, state.segments + 1)

    state = eqxi.while_loop(
        lambda state: state.t < t_end,
        integrate,
        State(t, x, p, holds, queue, xs, ps, jnp.asarray(-jnp.inf), jnp.asarray(0)),
        max_steps=max_segments,
        kind=kind,
    )
    # the output times at the last output time, after its events
    after = ts >= state.filled
    xs = jnp.where(after[:, None], state.x, state.xs)
    ps = jnp.where(after[:, None], state.p, state.ps)
    ts = eqx.error_if(
        ts,
        state.t < t_end,
        f"The integration took more than {max_segments} segments.",
    )
{% else %}
    ps = jnp.broadcast_to(p, (points, p.shape[0]))
{% if states %}
    solution = diffrax.diffeqsolve(
        diffrax.ODETerm(f_dxdt),
        diffrax.Kvaerno5() if solver is None else solver,
        t0=0.0,
        t1=t_end,
        dt0=None,
        y0=x,
        args=p,
        saveat=diffrax.SaveAt(ts=ts),
        stepsize_controller=diffrax.PIDController(rtol=rtol, atol=atol, dtmax=max_step),
        adjoint=diffrax.RecursiveCheckpointAdjoint() if adjoint is None else adjoint,
        max_steps=max_steps,
    )
    xs = solution.ys
{% else %}
    # without states there is nothing to integrate
    xs = jnp.broadcast_to(x, (points, 0))
{% endif %}
{% endif %}
    return Simulation(ts, xs, jax.vmap(f_y)(ts, xs, ps), ps)


def to_frame(simulation: Simulation) -> pd.DataFrame:
{% if event_constants %}
    """The simulation as a table: the time, the states, the assigned values and the
    constants which events change, a row per output time."""
    columns = [
        "time", *XIDS, *YIDS,
{% for c in event_constants %}
        "{{ c.id }}",
{% endfor %}
    ]
    constants = simulation.p[:, {{ wrapped(event_constants | map(attribute="index") | list, 4, 32, 1) }}]
    data = np.column_stack([simulation.t, simulation.x, simulation.y, constants])
{% else %}
    """The simulation as a table: the time, the states and the assigned values, a row
    per output time."""
    columns = ["time", *XIDS, *YIDS]
    data = np.column_stack([simulation.t, simulation.x, simulation.y])
{% endif %}
    return pd.DataFrame(data, columns=columns)


if __name__ == "__main__":
    print(to_frame(simulate(jnp.linspace(0.0, 10.0, 101))).head())
{% endif %}
