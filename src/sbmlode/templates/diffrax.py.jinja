# the root finder, a bisection in the step in which the function of a trigger changes
# its sign, locates its root to ROOT_TOLERANCE, the change of the trigger is searched
# within ROOT_WINDOW of it (relative to the time)
ROOT_TOLERANCE = 1e-12
ROOT_WINDOW = 1e-10


class ChangeBisection(optx.AbstractRootFinder):
    """The root finder of a change of the triggers in a step of the integration.

    diffrax passes the step as `lower` and `upper`, in which `trigger_change` turns
    from at most 0 to positive, or, for a simulation of a batch without a change
    while another one changes, the distance to the end of the step, whose root is
    `upper`. A bisection always converges, the iteration of Newton can leave the
    step, e.g. for a trigger `sin(10 * time) < 0`. The orientation of the function
    is that of its values at the ends of the step, the bisection ends when the
    interval is below the tolerances, and the root is the first time of the interval
    at which the function is positive.
    """

    rtol: float
    atol: float
    norm: ClassVar = jnp.abs

    def init(self, fn, y, args, options, f_struct, aux_struct, tags):
        lower = jnp.asarray(options["lower"], f_struct.dtype)
        upper = jnp.asarray(options["upper"], f_struct.dtype)
        lower_value, _ = fn(lower, args)
        upper_value, _ = fn(upper, args)
        # a root at the end of the step, the distance to it
        lower = jnp.where(upper_value == 0.0, upper, lower)
        return lower, upper, lower_value <= upper_value

    def step(self, fn, y, args, options, state, tags):
        lower, upper, increasing = state
        middle = lower + (upper - lower) / 2
        value, aux = fn(middle, args)
        before = (value <= 0.0) == increasing
        lower = jnp.where(before, middle, lower)
        upper = jnp.where(before, upper, middle)
        return upper, (lower, upper, increasing), aux

    def terminate(self, fn, y, args, options, state, tags):
        lower, upper, _ = state
        small = upper - lower <= self.atol + self.rtol * jnp.abs(upper)
        return small, optx.RESULTS.successful

    def postprocess(self, fn, y, aux, args, options, state, tags, result):
        return y, aux, {}


