def initial_values(p: jax.Array | None = None) -> tuple[jax.Array, jax.Array]:
    """The initial states x0 and the constants p at t = 0.

    The initial values, initial assignments and the rules they need are evaluated
    in the order of their dependencies.
{% if scopes.initial.computed %}

    These constants are computed, a value passed for them is replaced:

{% set computed = [] %}
{% for c in scopes.initial.computed %}
{% set origin = "initial assignment" if c.origin == "initial_assignment" else "converted with its compartment" %}
{% set _ = computed.append(["p[%d]" % c.index, c.id, origin]) %}
{% endfor %}
{{ table(computed, 8, docstring) }}
{% else %}

    Every constant keeps the value passed.
{% endif %}

    Args:
        p: the constants, `P0` if not given

    Returns:
        the initial states x0 and the constants p, a new array
    """
    p = P0 if p is None else jnp.asarray(p, dtype=float)
{% set scope = scopes.initial %}
{% if scope.time %}
    t = jnp.asarray(0.0)  # the initial time
{% endif %}
{% if scope.constants %}
    # constants
{% for c in scope.constants %}
    {{ c.code }} = p[{{ c.index }}]{{ comment(c.comment) }}
{% endfor %}
{% endif %}
{% if scope.assignments %}
    # initial values
{% for a in scope.assignments %}
    {{ a.code }} = {{ a.expr }}{{ comment(a.comment) }}
{% endfor %}
{% endif %}
{% if scope.computed %}
    # the constants set by the initial values
{% for c in scope.computed %}
    p = p.at[{{ c.index }}].set({{ c.code }})
{% endfor %}
{% endif %}
    x0 = jnp.array({{ wrapped(states | map(attribute="code") | list, 4, 19, 14) }}, dtype=float)
    return x0, p


