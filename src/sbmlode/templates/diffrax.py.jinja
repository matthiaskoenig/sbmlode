def loop_kind(adjoint: diffrax.AbstractAdjoint) -> str:
    """The kind of the loops of the events, which the adjoint differentiates.

    The loops of the segments and of a cascade of events are loops of
    `equinox.internal`, on which diffrax builds its adjoints: `"lax"` for forward
    mode (`diffrax.ForwardMode`), `"bounded"` for both modes (`diffrax.DirectAdjoint`)
    and `"checkpointed"` for reverse mode (every other adjoint).
    """
    if isinstance(adjoint, diffrax.ForwardMode):
        return "lax"
    if isinstance(adjoint, diffrax.DirectAdjoint):
        return "bounded"
    return "checkpointed"


